# Server environment
PORT=3000
NODE_ENV=development

# Authentication
JWT_SECRET=your-super-secret-key-here
JWT_EXPIRES_IN=24h

# Databases (Local/Docker mapping)
# If using local host MongoDB, use: mongodb://localhost:27017/agentmap
# If using Docker compose mapped port, use: mongodb://localhost:27018/agentmap
MONGODB_URI=mongodb://localhost:27018/agentmap

# Vector Database configuration
VECTOR_DB_TYPE=qdrant
VECTOR_DB_URL=http://localhost:6333
VECTOR_DB_API_KEY=

# Local Ollama Provider URL
OLLAMA_URL=http://localhost:11434

# LLM Providers & Models
GEMINI_API_KEY=your-gemini-api-key-here
GENAI_MODEL=gemini-2.5-flash

DEEPSEEK_API_KEY=your-deepseek-api-key-here
DEEPSEEK_MODEL=deepseek-chat

# Embedding Model configuration
EMBEDDING_MODEL=nomic-embed-text-v2-moe
